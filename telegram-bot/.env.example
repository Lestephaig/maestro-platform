# Copy this file to .env on the Telegram bot server.
# Never commit the real token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=MaestroBot
MAESTRO_BASE_URL=https://www.maestrocast.ru
# Must match TELEGRAM_LINK_API_TOKEN on the Maestro platform server.
MAESTRO_API_TOKEN=

# Dedicated inbound delivery secret. It must not equal MAESTRO_API_TOKEN.
TELEGRAM_DELIVERY_API_TOKEN=
TELEGRAM_DELIVERY_API_HOST=0.0.0.0
TELEGRAM_DELIVERY_API_PORT=8080
TELEGRAM_DELIVERY_DB_PATH=/app/data/delivery.sqlite3
# Keep 127.0.0.1 behind a reverse proxy. Set 0.0.0.0 only for direct public-IP
# access protected by a firewall allowlist.
TELEGRAM_DELIVERY_PUBLISH_HOST=127.0.0.1

# Telegram API and long-polling timeouts, seconds.
TELEGRAM_CONNECT_TIMEOUT=5
TELEGRAM_READ_TIMEOUT=20
TELEGRAM_WRITE_TIMEOUT=20
TELEGRAM_POOL_TIMEOUT=5
TELEGRAM_POLL_TIMEOUT=30
