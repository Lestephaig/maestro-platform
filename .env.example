# Safe defaults for local development. Never commit the real .env file.
SECRET_KEY=dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Leave empty to use SQLite. For local PostgreSQL or Docker Compose, use:
# DATABASE_URL=postgresql://maestro_user:maestro_password@localhost:5432/maestro_db
# DATABASE_URL=postgresql://maestro_user:maestro_password@db:5432/maestro_db
DATABASE_URL=

# Use redis://redis:6379/0 when the web process runs in Docker Compose.
REDIS_URL=redis://127.0.0.1:6379/0

# Print development email to the console. Configure SMTP in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Maestro <noreply@localhost>

SITE_URL=http://127.0.0.1:8000

# Uploads and logging
MAX_UPLOAD_SIZE_MB=35
DJANGO_LOG_LEVEL=INFO
DJANGO_MAIL_LOG_LEVEL=DEBUG

# Static and reverse-proxy behavior
USE_WHITENOISE=True
USE_X_FORWARDED_HOST=False

# Production-only security examples (used when DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
